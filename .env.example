# Copy to .env and adjust. Every new variable gets documented HERE.

# Local port (loopback only; exposed via Tailscale Serve)
PORT=8080

# Data folder (SQLite + audio). Created automatically if missing.
DATA_DIR=./data

# App and token registry (hot-reloads when modified)
APPS_FILE=./apps.yml

# Transcription with faster-whisper (requires requirements-transcribe.txt).
# With false, audios stay transcript_status=pending until it's enabled.
WHISPER_ENABLED=false
# Model: tiny | base | small ... (on a 1 GB e2-micro: base int8 + swap; if OOM, tiny)
WHISPER_MODEL=base

# Audio upload size limit in MB
MAX_AUDIO_MB=20
