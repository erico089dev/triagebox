# Copy to .env and adjust. Every new variable gets documented HERE.

# Local port (loopback only; exposed via Tailscale Serve)
PORT=8080

# Data folder (SQLite + audio). Created automatically if missing.
DATA_DIR=./data

# App and token registry (hot-reloads when modified)
APPS_FILE=./apps.yml

# Master switch for the async transcription worker. With false, audios stay
# transcript_status=pending until it's enabled (nothing is lost).
WHISPER_ENABLED=false

# Engine: groq (default) or local.
#   groq  -> a small multipart call to Groq's Whisper API. No ML on the VM,
#            tiny RAM. Needs GROQ_API_KEY below. Recommended when co-hosting.
#   local -> faster-whisper in-process (needs requirements-transcribe.txt +
#            enough RAM). Set WHISPER_MODEL below.
TRANSCRIBE_PROVIDER=groq

# --- groq provider (same account/key as Duna's backend) ---
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
# Optional bilingual context (ca/es) to help mixed-language voice notes.
GROQ_WHISPER_PROMPT=
# Optional language (ISO-639-1, e.g. es or ca). Empty = auto-detect.
GROQ_WHISPER_LANGUAGE=

# --- local provider (faster-whisper) ---
# Model: tiny | base | small ... (on a 1 GB e2-micro: base int8 + swap; if OOM, tiny)
WHISPER_MODEL=base

# Audio upload size limit in MB
MAX_AUDIO_MB=20
